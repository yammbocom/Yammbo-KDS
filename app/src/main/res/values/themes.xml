<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Sigue al sistema: blanco de dia, negro en modo noche. La pantalla de
         comandas va negra siempre, como la web del KDS (lo pone MainActivity):
         una tablet colgada en cocina se mira de lejos y el blanco a pantalla
         completa deslumbra de noche. B/N estricto: el acento es el texto. -->
    <style name="Tema.Yammbo" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/yk_fondo</item>
        <item name="android:colorBackground">@color/yk_fondo</item>
        <item name="android:colorBackgroundFloating">@color/yk_fondo</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/yk_barras_claras</item>
        <item name="android:textColorPrimary">@color/yk_texto</item>
        <item name="android:textColorSecondary">@color/yk_secundario</item>
        <item name="colorPrimary">@color/yk_texto</item>
        <item name="colorPrimaryDark">@color/yk_fondo</item>
        <item name="colorAccent">@color/yk_texto</item>
        <item name="colorControlNormal">@color/yk_secundario</item>
        <item name="colorControlActivated">@color/yk_texto</item>
        <item name="colorControlHighlight">@color/yk_pulsado</item>
        <item name="alertDialogTheme">@style/Tema.Yammbo.Dialogo</item>
    </style>

    <style name="Tema.Yammbo.Dialogo" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/fondo_dialogo</item>
        <item name="android:textColorPrimary">@color/yk_texto</item>
        <item name="android:textColorSecondary">@color/yk_secundario</item>
        <item name="colorAccent">@color/yk_texto</item>
        <item name="colorControlNormal">@color/yk_secundario</item>
        <item name="colorControlActivated">@color/yk_texto</item>
        <item name="colorControlHighlight">@color/yk_pulsado</item>
    </style>
</resources>
